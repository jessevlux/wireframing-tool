  "pages": [
    {
      "page": "Homepage (DUMMY)",
      "section": "homePage",
      "rationale": "De homepage fungeert als segmentatie-hub met een sterke hero die AUGA's kernboodschap presenteert, gevolgd door drie duidelijk gescheiden segment-kaarten met USPs. Dit ondersteunt de customer journey door bezoekers direct naar hun relevante markt te leiden en conversie-intent op te bouwen.",
      "blocks": [
        {
          "component": "Hero",
          "props": {
            "Has Title": true,
            "Hero Title": "Pompen voor elke markt",
            "Has Description": true,
            "Description": "AUGA levert innovatieve pompoplossingen voor vijvers, tuinen en industrie. Kies uw segment en ontdek de perfecte oplossing.",
            "Has Usps": true,
            "Usp 1": "Meer dan 20 jaar expertise",
            "Usp 2": "Duurzame en efficiënte oplossingen",
            "Usp 3": "Persoonlijk advies en support",
            "Has Button Primary": true,
            "Has Button Secondary": false
          },
          "children": [
            {
              "component": "Button Primary",
              "props": {
                "Property 1": "Default",
                "Text primary button": "Ontdek uw segment"
              }
            }
          ]
        },
        {
          "component": "Grid",
          "props": {
            "Property 1": "Default",
            "Title": "Onze drie marktsegmenten"
          },
          "children": [
